# ─────────────────────────────────────────────
#  GeoIP API – Environment Configuration
# ─────────────────────────────────────────────

# Path to GeoLite2-City.mmdb
GEOIP_DB_PATH=GeoLite2-City.mmdb

# API host and port
API_HOST=0.0.0.0
API_PORT=8000

# Rate limiting (requests per minute per IP)
RATE_LIMIT=60

# API key protection (leave blank to disable)
# If set, clients must send:  X-API-Key: <your-key>
API_KEY=

# App environment: development | production
APP_ENV=development
