# ─────────────────────────────────────────────
#  GeoIP API – Environment Configuration
# ─────────────────────────────────────────────

# Path to GeoLite2-City.mmdb
GEOIP_DB_PATH=GeoLite2-City.mmdb

# API host and port
API_HOST=0.0.0.0
API_PORT=8089

# Rate limiting fallback (requests per minute per IP, used when no DB token)
RATE_LIMIT=60

# Legacy single API key (leave blank to use per-user tokens from the dashboard)
# If set, clients must send:  X-API-Key: <your-key>
API_KEY=

# App environment: development | production
APP_ENV=development

# ── Dashboard / Auth ──────────────────────────────────────────────────────────
# IMPORTANT: Change this to a long random string in production!
SECRET_KEY=change-me-in-production-use-a-long-random-string

# SQLite (default) or PostgreSQL
DATABASE_URL=sqlite:///./geoip_userstest.db

# Session token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60
